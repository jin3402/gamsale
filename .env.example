# 모두 선택 사항이에요. 값이 없으면 기본 동작을 그대로 써요.

# 환율 API(open.er-api.com) 실패 시 쓸 USD→KRW 폴백 환율
# - 앱 런타임 기본값: 1350 (src/features/game-deals/api/config.ts)
# - 스냅샷 스크립트 기본값: 1450 (scripts/generate-deal-snapshots.mjs, PS·Xbox 원화 환산에 고정 적용)
#   스크립트는 .env를 읽지 않으니 `VITE_USD_KRW_RATE=1400 npm run snapshot:deals`처럼 셸에서 넘겨요.
# VITE_USD_KRW_RATE=1450

# 운영 빌드에서도 외부 API를 Vite 프록시 경로로 호출하고 싶을 때만 true
# (vite dev에서는 항상 프록시를 써요)
# VITE_USE_CHEAPSHARK_PROXY=true
# VITE_USE_NINTENDO_PROXY=true
# VITE_USE_PLAYSTATION_PROXY=true
# VITE_USE_XBOX_PROXY=true
# VITE_USE_FX_PROXY=true
