{
  "name": "game-deal-alert",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
    "snapshot:deals": "node ./scripts/generate-deal-snapshots.mjs",
    "prebuild": "node ./scripts/generate-deal-snapshots.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/@apps-in-toss/web-framework/bin/ait.js build",
    "build:web": "node ./node_modules/vite/bin/vite.js build --config vite.web.config.ts",
    "lint": "eslint .",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "deploy": "node ./node_modules/@apps-in-toss/web-framework/bin/ait.js deploy",
    "dev:web": "node ./node_modules/vite/bin/vite.js --config vite.web.config.ts",
    "preview:web": "node ./node_modules/vite/bin/vite.js preview --config vite.web.config.ts"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.6.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "^2.3.0",
    "@toss/tds-mobile-ait": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "@apps-in-toss/devtools": "^3.6.0"
  }
}
